---
// Fixed bottom bar on phones: replaces the floating chat (R-001, R-010, R-017).
import { hotline, ambulance } from "../data/odrex";
---
<nav class="bar" aria-label="Швидкий зв'язок" data-rec="R-001,R-010,R-017">
  <a class="bar__item bar__item--main" href={hotline.href}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    <span>Подзвонити</span>
  </a>
  <a class="bar__item" href="#zapys">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L3 21l1.9-6.4A8 8 0 1 1 21 12z"/></svg>
    <span>Написати</span>
  </a>
  <a class="bar__item" href={ambulance.shortHref} aria-label="Швидка допомога: 9000 з мобільного">
    <span class="plate">9000</span>
    <span>Швидка</span>
  </a>
</nav>
<style>
  .bar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2);
    padding: var(--s-2) var(--s-2) calc(var(--s-2) + env(safe-area-inset-bottom, 0px));
    background: var(--paper); border-top: 1px solid var(--hair);
  }
  .bar__item {
    display: flex; align-items: center; justify-content: center; gap: var(--s-2); padding-inline: 4px;
    min-height: 48px; border-radius: var(--radius);
    font-weight: 600; font-size: var(--fs-small); text-decoration: none; color: var(--ink);
    background: var(--surface-2);
  }
  .bar__item:active { transform: translateY(1px); }
  .bar__item--main { background: var(--action); }
  .bar__item .plate { font-size: 13px; padding: 0 .3em; }
  @media (max-width: 359px) { .bar__item svg { display: none; } }
  @media (min-width: 1024px) { .bar { display: none; } }
</style>
