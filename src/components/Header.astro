---
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { hotline, ambulance, mobiles, messengers, email } from "../data/odrex";
const nav = [
  { href: "#napryamy", label: "Напрями" },
  { href: "#adresy", label: "Адреси" },
  { href: "#simeyna", label: "Сімейний лікар" },
  { href: "#programy", label: "Check-up" },
  { href: "#dovira", label: "Про нас" },
];
---
<header id="header" class="hdr" data-rec="R-005">
  <div class="wrap hdr__in">
    <Logo class="hdr__logo" />

    <nav class="hdr__nav" aria-label="Розділи головної">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="hdr__acts">
      <a class="hdr__urgent" href={ambulance.cityHref} aria-label={`Швидка допомога Odrex: ${ambulance.city}, з мобільного ${ambulance.short}`}>
        <span>Швидка</span><span class="plate">9000</span>
      </a>
      <a class="hdr__hot" href={hotline.href}>
        <span class="tel">{hotline.label}</span>
        <span class="hdr__hot-note">гаряча лінія · цілодобово</span>
      </a>
      <a class="btn btn--main hdr__book" href="#zapys">Записатися</a>
      <FutureLink class="hdr__lang" note="Російська версія — у повній версії сайту">RU</FutureLink>
    </div>

    <a class="hdr__call" href={hotline.href} aria-label={`Подзвонити на гарячу лінію ${hotline.label}`}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    </a>

    <details class="menu">
      <summary class="menu__btn" aria-label="Меню">
        <span class="menu__bars" aria-hidden="true"><i></i><i></i></span>
        <span class="menu__txt">Меню</span>
      </summary>
      <div class="menu__panel">
        <ul class="menu__nav">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="#zapys">Канали запису</a></li>
        </ul>
        <div class="menu__contacts">
          <a class="menu__hot" href={hotline.href}><span class="tel">{hotline.label}</span><span class="small">гаряча лінія · цілодобово</span></a>
          <a class="menu__urgent" href={ambulance.shortHref}><span class="plate">9000</span><span>Швидка з мобільного</span></a>
          <ul class="small menu__mob">{mobiles.map((m) => <li><a class="tel" href={m.href}>{m.label}</a></li>)}</ul>
          <ul class="small menu__msg">{messengers.map((m) => <li><a href={m.href}>{m.name}</a></li>)}<li><a href={email.href}>E-mail</a></li></ul>
          <FutureLink note="Російська версія — у повній версії сайту">Версія російською</FutureLink>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 1px solid var(--hair); }
  .hdr__in { display: flex; align-items: center; gap: var(--s-4); height: var(--header-h); }
  .hdr :global(.hdr__logo) { --logo-h: 34px; margin-right: auto; }
  .hdr__nav, .hdr__acts { display: none; }

  .hdr__call {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--action); color: var(--ink);
  }
  .hdr__call:active { transform: translateY(1px); }

  .menu { position: static; }
  .menu__btn {
    list-style: none; display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: 44px; padding: 0 var(--s-2); cursor: pointer; font-weight: 600; border-radius: var(--radius);
  }
  .menu__btn::-webkit-details-marker { display: none; }
  .menu__bars { display: grid; gap: 8px; width: 22px; }
  .menu__bars i { display: block; height: 2px; background: var(--ink); border-radius: 1px; transition: transform var(--t-arrow) var(--ease-out); }
  .menu[open] .menu__bars i:first-child { transform: translateY(5px) rotate(45deg); }
  .menu[open] .menu__bars i:last-child { transform: translateY(-5px) rotate(-45deg); }
  .menu__panel {
    position: absolute; left: 0; right: 0; top: 100%;
    max-height: calc(100dvh - var(--header-h) - var(--bar-h));
    overflow-y: auto;
    background: var(--paper); border-bottom: 1px solid var(--hair);
    padding: var(--s-2) var(--gutter) var(--s-6);
  }
  .menu__nav li { border-bottom: 1px solid var(--hair); }
  .menu__nav a {
    display: flex; align-items: center; min-height: 56px; white-space: nowrap;
    font: 700 var(--fs-h3)/1.1 var(--font-display); letter-spacing: -0.01em; text-decoration: none;
  }
  .menu__contacts { display: grid; gap: var(--s-4); padding-top: var(--s-5); }
  .menu__hot { display: grid; text-decoration: none; font: 700 28px/1.1 var(--font-display); }
  .menu__hot .small { font-family: var(--font-body); font-weight: 400; color: var(--ink-2); }
  .menu__urgent { display: inline-flex; align-items: center; gap: var(--s-3); min-height: 44px; font-weight: 600; text-decoration: none; }
  .menu__urgent .plate { font-size: 20px; }
  .menu__mob, .menu__msg { display: flex; flex-wrap: wrap; gap: 0 var(--s-5); }
  .menu__mob a, .menu__msg a { color: var(--link); display: inline-flex; align-items: center; min-height: 44px; }

  @media (min-width: 1200px) {
    .hdr__call, .menu { display: none; }
    .hdr__in { gap: var(--s-5); }
    .hdr :global(.hdr__logo) { --logo-h: 40px; margin-right: 0; }
    .hdr__nav { display: block; margin-right: auto; }
    .hdr__nav ul { display: flex; gap: var(--s-1); }
    .hdr__nav a {
      display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--s-3);
      font-weight: 400; white-space: nowrap; text-decoration: none; border-radius: var(--radius);
      transition: background-color var(--t-fast) var(--ease-out);
    }
    .hdr__nav a:hover { background: var(--surface-2); }
    .hdr__acts { display: flex; align-items: center; gap: var(--s-4); }
    .hdr__urgent {
      display: inline-flex; align-items: center; gap: var(--s-2); min-height: 44px;
      color: var(--urgent); font-weight: 600; text-decoration: none; border-radius: var(--radius);
    }
    .hdr__urgent .plate { font-size: 17px; }
    .hdr__urgent:hover span:first-child { text-decoration: underline; }
    .hdr__hot { display: none; text-decoration: none; line-height: 1.15; }
    .hdr__hot .tel { display: block; font: 700 19px/1.15 var(--font-display); }
    .hdr__hot-note { display: block; font-size: var(--fs-small); color: var(--ink-2); }
    .hdr__hot:hover .tel { color: var(--link); }
    .hdr__book { min-height: 44px; }
    .hdr :global(.hdr__lang) { font-size: var(--fs-small); }
  }
  @media (min-width: 1400px) {
    .hdr__hot { display: block; }
  }
</style>
